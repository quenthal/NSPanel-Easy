macro report_api_unavailable:
  // Report to ESPHome that Home Assistant is needed
  printh 93
  prints "api_unavailable",0
  printh 00 01 FF FF FF

macro theme_apply:
  if(theme==1)
  {
    // LIGHT theme
    // global background
    pic_background_main=48
    pic_background_home=@pic(picture-0134)
    // home page - weather pic
    if(home.weather.pic<48)
    {
      home.weather.pic+=48
    }
    // buttons pages
    pic_button_off=79 // Background picture for non-pressed buttons on buttonpageXX
    // cover page
    cover.coverslider2.pic=@pic(picture-0112)
    cover.coverslider2.pic1=@pic(picture-0113)
    cover.coverslider.pic=@pic(picture-0105)
    cover.coverslider.pic1=@pic(picture-0107)
    cover.tiltslider.pic=@pic(picture-0109)
    cover.tiltslider.pic1=@pic(picture-0111)
    // fan page
    fan.fanslider.pic=@pic(picture-0072)
    fan.fanslider.pic1=@pic(picture-0073)
  }else
  {
    // DARK theme
    // global background
    pic_background_main=0
    pic_background_home=0
    // home page - weather pic
    if(home.weather.pic>48)
    {
      home.weather.pic-=48
    }
    // buttons pages
    pic_button_off=46 // Background picture for non-pressed buttons on buttonpageXX
    // cover page
    cover.coverslider2.pic=@pic(picture-0020)
    cover.coverslider2.pic1=@pic(picture-0019)
    cover.coverslider.pic=@pic(picture-0104)
    cover.coverslider.pic1=@pic(picture-0106)
    cover.tiltslider.pic=@pic(picture-0108)
    cover.tiltslider.pic1=@pic(picture-0110)
    // fan page
    fan.fanslider.pic=@pic(picture-0039)
    fan.fanslider.pic1=@pic(picture-0040)
  }
  // Page backgrounds are set by each page's load event (home, climate): a page's own
  // picture cannot be reached from another page, and the page reloads after this macro
  // home time, date and temperatures
  home.time.picc=pic_background_home
  home.time.pco=color_pco_main
  home.indr_temp.picc=pic_background_home
  home.indr_temp.pco=color_pco_main
  home.outdoor_temp.picc=pic_background_home
  home.outdoor_temp.pco=color_pco_main
  home.date.picc=pic_background_home
  home.date.pco=color_pco_main
  home.indr_temp_icon.picc=pic_background_home
  home.indr_temp_icon.pco=color_pco_main
  home.meridiem.picc=pic_background_home
  home.meridiem.pco=color_pco_main
  // home hw button's labels
  home.right_bt_text.picc=pic_background_home
  home.left_bt_text.picc=pic_background_home
  home.wifi_icon.picc=pic_background_home
  home.bt_icon.picc=pic_background_home
  // home values 01-04
  home.value01.picc=pic_background_home
  home.value01_icon.picc=pic_background_home
  home.value02.picc=pic_background_home
  home.value02_icon.picc=pic_background_home
  home.value03.picc=pic_background_home
  home.value03_icon.picc=pic_background_home
  home.value04.picc=pic_background_home
  home.value04_icon.picc=pic_background_home
  // home chips
  home.chip_relay1.picc=pic_background_home
  home.chip_relay2.picc=pic_background_home
  home.chip_climate.picc=pic_background_home
  home.chip01.picc=pic_background_home
  home.chip02.picc=pic_background_home
  home.chip03.picc=pic_background_home
  home.chip04.picc=pic_background_home
  home.chip05.picc=pic_background_home
  home.chip06.picc=pic_background_home
  home.chip07.picc=pic_background_home
  // home buttons
  home.bt_notific.picc=pic_background_home
  home.bt_qrcode.picc=pic_background_home
  home.bt_entities.picc=pic_background_home
  home.button07.picc=pic_background_home
  home.button01.picc=pic_background_home
  home.button02.picc=pic_background_home
  home.button03.picc=pic_background_home
  home.button04.picc=pic_background_home
  home.button05.picc=pic_background_home
  home.button06.picc=pic_background_home
  home.bt_utilities.picc=pic_background_home

macro format_tenths:
  // Formats a value in tenths as text, with one decimal only when the step is not a whole number
  // In:      sys0 = value in tenths, sys1 = step in tenths
  // Out:     home.tenths_txt.txt
  // Changes: sys0, sys2, home.tenths_tmp.txt
  if(sys0<0)
  {
    home.tenths_txt.txt="-"
    sys0=0-sys0
  }else
  {
    home.tenths_txt.txt=""
  }
  sys2=sys0/10
  covx sys2,home.tenths_tmp.txt,0,0
  home.tenths_txt.txt+=home.tenths_tmp.txt
  sys2=sys1%10
  if(sys2!=0)
  {
    sys2=sys0%10
    covx sys2,home.tenths_tmp.txt,0,0
    home.tenths_txt.txt+=home.dec_sep.txt+home.tenths_tmp.txt
  }
